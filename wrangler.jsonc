{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Deploy name for this Worker. The public app name lives in site.config.json.
  "name": "dova-landing",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
